# Copy this file to .env and replace the local-only password before startup.
POSTGRES_DB=fx_analyzer
POSTGRES_USER=fx_analyzer
POSTGRES_PASSWORD=replace-with-a-local-password
# Migration/owner connection. Application processes use the restricted role below.
DATABASE_URL=postgresql+psycopg://fx_analyzer:replace-with-a-local-password@db:5432/fx_analyzer
APP_DATABASE_USER=fx_analyzer_app
APP_DATABASE_PASSWORD=replace-with-a-different-local-password
APP_DATABASE_URL=postgresql+psycopg://fx_analyzer_app:replace-with-a-different-local-password@db:5432/fx_analyzer
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL=5
WORKER_LEASE_TIMEOUT=300
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=60
CODE_VERSION=local
METRICS_ENABLED=false
